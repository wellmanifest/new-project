{
  "version": "office.dsl.v1",
  "task": { "id": "example-06", "title": "Invoice log analysis", "input": "Znajdz w logach nieudane proby przetwarzania faktur i przygotuj podsumowanie.", "createdBy": "example" },
  "sources": [{ "id": "activity_logs", "connector": "mock", "name": "mock.activity_logs" }],
  "steps": [
    { "id": "search-logs", "description": "Search failed invoice logs", "action": "log.search", "with": { "contains": "invoice failed" }, "saveAs": "logs" },
    { "id": "report", "description": "Generate log summary", "action": "report.generate", "with": { "from": "logs", "title": "Failed invoice processing attempts" }, "saveAs": "report" }
  ],
  "output": { "format": "json", "saveAs": "result" },
  "policies": [{ "decision": "ALLOW", "subject": "log.search", "reason": "Read mock logs only" }],
  "expectedResults": ["Read mock logs", "Prepare summary"],
  "errorHandling": { "onFailure": "stop" }
}
