{
  "version": "office.dsl.v1",
  "task": {
    "id": "example-01",
    "title": "Unpaid invoices report",
    "input": "Przygotuj raport niezaplaconych faktur starszych niz 30 dni.",
    "createdBy": "example"
  },
  "sources": [{ "id": "invoices", "connector": "mock", "name": "mock.invoices" }],
  "steps": [
    {
      "id": "load-overdue",
      "description": "Read unpaid invoices older than 30 days",
      "action": "database.query",
      "with": { "dataset": "invoices", "kind": "unpaidInvoicesOlderThanDays", "days": 30 },
      "saveAs": "overdue"
    },
    {
      "id": "report",
      "description": "Generate read-only report",
      "action": "report.generate",
      "with": { "from": "overdue", "title": "Unpaid invoices older than 30 days" },
      "saveAs": "report"
    }
  ],
  "output": { "format": "json", "saveAs": "result" },
  "policies": [
    { "decision": "ALLOW", "subject": "read-only-report", "reason": "Mock data read only" }
  ],
  "expectedResults": ["Read mock data", "Generate report", "No confirmation required"],
  "errorHandling": { "onFailure": "stop" }
}
