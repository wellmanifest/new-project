{
  "version": "office.dsl.v1",
  "task": {
    "id": "example-04",
    "title": "Send prepared reminders",
    "input": "Wyslij przygotowane przypomnienia.",
    "createdBy": "example"
  },
  "sources": [{ "id": "invoices", "connector": "mock", "name": "mock.invoices" }],
  "steps": [
    {
      "id": "load-overdue",
      "description": "Read unpaid invoices older than 30 days",
      "action": "database.query",
      "with": { "dataset": "invoices", "kind": "unpaidInvoicesOlderThanDays", "days": 30 },
      "saveAs": "overdue"
    },
    {
      "id": "prepare",
      "description": "Prepare reminder messages",
      "action": "email.prepare",
      "with": { "from": "overdue" },
      "saveAs": "messages"
    },
    {
      "id": "send",
      "description": "Write sent messages to mock outbox",
      "action": "email.send",
      "with": { "from": "messages" },
      "saveAs": "sendResult",
      "confirm": {
        "id": "send-reminders",
        "prompt": "Confirm sending reminders to mock outbox",
        "required": true
      }
    }
  ],
  "output": { "format": "json", "saveAs": "result" },
  "policies": [
    { "decision": "REQUIRE", "subject": "email.send", "reason": "Confirmation required" }
  ],
  "expectedResults": ["Show recipients", "Require confirmation", "Write to mock outbox only"],
  "errorHandling": { "onFailure": "stop" }
}
