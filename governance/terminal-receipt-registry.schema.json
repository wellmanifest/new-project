{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/new-project/terminal-receipt-registry.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repositoryRef", "receipts"],
  "properties": {
    "schema": {"const": "new-project.terminal-receipt-registry/v1"},
    "repositoryRef": {"type": "string", "minLength": 1},
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receiptRef", "ticket", "outcome", "headSha", "terminalSha", "targetBranch", "occurredAt"],
        "properties": {
          "receiptRef": {"type": "string", "pattern": "^receipt:\\S+$"},
          "ticket": {"type": "string", "pattern": "^ticket-[0-9]{3,}$"},
          "outcome": {"type": "string", "minLength": 1},
          "headSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "terminalSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "targetBranch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "occurredAt": {"type": "string", "format": "date-time"},
          "decision": {
            "description": "Owner/controller decision for a ticket whose pull request was closed without merge; required by owner-decision verification.",
            "type": "object",
            "additionalProperties": false,
            "required": ["pullRequest", "pullRequestState", "decidedBy", "decisionRef"],
            "properties": {
              "pullRequest": {"type": "integer", "minimum": 1},
              "pullRequestState": {"const": "closed-unmerged"},
              "decidedBy": {"type": "string", "pattern": "^[A-Za-z0-9._:\\[\\]-]{1,100}$"},
              "decisionRef": {"type": "string", "pattern": "^\\S{1,500}$"}
            }
          }
        }
      }
    }
  }
}
