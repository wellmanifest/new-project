{
  "$schema": "./manifest.schema.json",
  "schema": "new-project.governance/v2",
  "standard": {
    "id": "wellmanifest/new-project",
    "version": "0.19.21"
  },
  "requiredFiles": [
    "README.md",
    "VERSION",
    "CHANGELOG.md",
    "TODO.md",
    "AGENTS.md",
    "project/TICKETS.md",
    "project/new-ticket.sh",
    "project/readme.sh"
  ],
  "governancePaths": [
    "TODO.md",
    "project/TICKETS.md",
    "project/ticket-*/**",
    ".governance/standard-adoption.json",
    "config/artifact-registry.json"
  ],
  "trustedApprovalSources": [
    "github-review",
    "github-app-review",
    "signed-attestation"
  ],
  "approvalEvidence": {
    "schema": "new-project.approval-evidence/v1",
    "requiredBindings": [
      "repository",
      "pullRequest",
      "headSha",
      "ticket",
      "actor"
    ],
    "reviewVerificationMethod": "github-api-allowlist",
    "signedAttestationPredicateType": "https://wellmanifest.com/attestations/validator/v1"
  },
  "ticket": {
    "root": "project",
    "directoryPattern": "^ticket-[0-9]{3}$",
    "requiredFiles": [
      "README.md",
      "intent.json"
    ],
    "requiredAgentFiles": [],
    "activeStatuses": [
      "IN_PROGRESS"
    ],
    "nonActiveStatuses": [
      "BACKLOG",
      "PLAN",
      "BLOCKED"
    ],
    "closedStatuses": [
      "DONE",
      "CANCELLED"
    ],
    "implementationStates": [
      "EDIT",
      "VALIDATION",
      "PUBLICATION"
    ],
    "intentFile": "intent.json"
  },
  "docker": {
    "required": false,
    "dockerfiles": [
      "Dockerfile",
      "Dockerfile.e2e"
    ],
    "composeFiles": [
      "compose.yml",
      "compose.yaml",
      "docker-compose.yml",
      "docker-compose.yaml",
      "compose.e2e.yml"
    ]
  },
  "coordination": {
    "mode": "workstreams",
    "maxActiveTicketsPerWorkstream": 1,
    "rejectActiveScopeOverlap": true,
    "workstreams": {
      "governance": {
        "ownedPaths": [
          "**"
        ]
      }
    },
    "integration": {
      "workstream": "governance",
      "requiredForPaths": []
    }
  },
  "delivery": {
    "requiredForImplementation": true,
    "maxActiveMinutes": 30,
    "checkpointMinutes": 25,
    "allowedComplexityClasses": [
      "XS",
      "S"
    ],
    "maxImplementationFiles": 24,
    "maxAffectedComponents": 3,
    "maxPublicInterfaceChanges": 3,
    "maxRuntimeDependencies": 0,
    "targetBranches": [
      "main"
    ],
    "publicInterfacePaths": [
      ".github/workflows/ci.yml",
      "goal.yaml",
      "scripts/governance_check.py"
    ],
    "dependencyManifestPaths": []
  },
  "stacks": []
}
