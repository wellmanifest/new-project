FROM node:22-bookworm-slim AS e2e

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OFFICE_DSL_LLM_MODE=mock \
    OFFICE_DSL_VERIFIER_MODE=mock \
    OFFICE_DSL_DATA_DIR=mock-data \
    OFFICE_DSL_TASK_DIR=.office-dsl/docker/tasks \
    OFFICE_DSL_AUDIT_DIR=.office-dsl/docker/audit \
    OFFICE_DSL_EXPORT_DIR=.office-dsl/docker/exports

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json eslint.config.js vitest.config.ts ./
COPY packages ./packages
COPY apps ./apps
COPY tests ./tests
COPY verifier ./verifier
COPY examples ./examples
COPY examples-chat ./examples-chat
COPY examples-recruitment ./examples-recruitment
COPY mock-data ./mock-data
COPY docs ./docs
COPY README.md TODO.md CHANGELOG.md CONTRIBUTING.md POLICY.md HANDOFF.md VERSION project.sh ./

RUN corepack enable && corepack pnpm install --frozen-lockfile

CMD ["bash", "project.sh", "verify"]
